# Copy this file to .env or export these variables in your shell.
# Never commit a real API key.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_ENDPOINT=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-flash
# Optional: absolute path to a compatible Electron executable (e.g. Electron 37 on macOS 12).
# ELECTRON_EXEC_PATH=/absolute/path/to/Electron.app/Contents/MacOS/Electron
