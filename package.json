{
  "name": "pingforai",
  "productName": "PingForAI",
  "version": "0.5.1",
  "private": true,
  "description": "Point at desktop content to ask your vision AI, with custom signal tasks and local screenshot controls",
  "author": "ju-sir (https://github.com/ju-sir)",
  "contributors": [
    "Danrui Meng (https://github.com/darrenprx)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ju-sir/PingForAI#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ju-sir/PingForAI.git"
  },
  "bugs": "https://github.com/ju-sir/PingForAI/issues",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "electron-vite build",
    "start": "node --env-file-if-exists=.env node_modules/electron-vite/bin/electron-vite.js preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai": "vitest run --config vitest.ai.config.ts --coverage --maxWorkers=2",
    "build:helper": "node native/hook-helper/run.mjs build",
    "test:helper": "node native/hook-helper/run.mjs test",
    "dist": "npm run build:helper && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "npm run build:helper && electron-vite build && electron-builder --mac --arm64 --publish never",
    "dev:site": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "media": "npm run build:site && electron tools/capture-media/capture.mjs"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@noble/secp256k1": "3.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "dompurify": "3.4.17",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "jsdom": "29.1.1",
    "marked": "18.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "build": {
    "appId": "com.pingforai.app",
    "productName": "PingForAI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper.exe",
          "to": "hook-helper.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PingForAI-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper",
          "to": "hook-helper"
        },
        {
          "from": "build",
          "to": ".",
          "filter": [
            "tray*Template*.png"
          ]
        }
      ],
      "extendInfo": {
        "NSAccessibilityUsageDescription": "PingForAI reads the mouse and keyboard to open the ping wheel or the emote wheel when you hold its key and drag.",
        "NSDownloadsFolderUsageDescription": "PingForAI saves update downloads to your Downloads folder.",
        "NSLocalNetworkUsageDescription": "PingForAI finds the other people in your room on the local network and sends them your pings."
      }
    },
    "dmg": {
      "artifactName": "PingForAI-${version}-arm64.dmg"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ju-sir",
        "repo": "PingForAI"
      }
    ]
  }
}
